[Unit]
Description=Minecraft Server (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft/%i
Environment=HOME=/srv/minecraft/%i
Environment=SHELL=/bin/bash
RuntimeDirectory=minecraft-%i
RuntimeDirectoryMode=0750

ExecStart=/usr/local/libexec/minecraft-supervisor %i
ExecStop=/usr/local/libexec/minecraft-stop %i

Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillMode=control-group

UMask=0027
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
