#!/bin/sh
set -eu

node=${MCCTL_NODE:-$(command -v node || true)}
if [ -z "$node" ]; then
    echo "mcctl-dashboard: Node.js 22 or newer is required; set MCCTL_NODE in /etc/default/mcctl-dashboard." >&2
    exit 1
fi

major=$("$node" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)
if [ -z "$major" ] || [ "$major" -lt 22 ]; then
    echo "mcctl-dashboard: Node.js 22 or newer is required (found ${major:-unknown})." >&2
    exit 1
fi

exec "$node" /usr/local/libexec/mcctl-dashboard/server.mjs